# SPDX-License-Identifier: MIT
set(bundle "${CMAKE_INSTALL_PREFIX}/@CMAKE_PROJECT_PROPER_NAME@.app")
set(binary_dir "${bundle}/Contents/MacOS")
set(plugin_dir "${binary_dir}/gstreamer-1.0")
file(GLOB previous_plugins "${plugin_dir}/*")
if(previous_plugins)
  message(FATAL_ERROR "Use a fresh macOS staging directory for streaming packaging")
endif()
set(plugin_sources "@STREAMING_PLUGIN_FILES@")
file(COPY ${plugin_sources} DESTINATION "${plugin_dir}")
file(COPY "@STREAMING_SCANNER_DIR@/gst-plugin-scanner" DESTINATION "${binary_dir}")
file(COPY "@STREAMING_MEDIA_LICENSE_DIR@/" DESTINATION "${bundle}/Contents/Resources/licenses/gstreamer")
file(COPY "@CMAKE_SOURCE_DIR@/deploy/licenses/qt-6.10.3" DESTINATION "${bundle}/Contents/Resources/licenses")
file(WRITE "${binary_dir}/streaming-runtime.version" "1.28.7\n")
# Development builds carry a build-tree marker; a package must only use its private runtime.
file(REMOVE "${binary_dir}/streaming-runtime.development")

# The official SDK links everything through @rpath. BundleUtilities cannot resolve
# @rpath Qt frameworks, so copy the SDK dylib closure into Contents/Frameworks explicitly.
set(sdk_lib_dir "@STREAMING_PREFIX@/lib")
set(frameworks_dir "${bundle}/Contents/Frameworks")
file(GLOB plugins "${plugin_dir}/*.dylib")
set(pending ${plugins} "${binary_dir}/gst-plugin-scanner" "${binary_dir}/@CMAKE_PROJECT_PROPER_NAME@"
  "${binary_dir}/deskflow-core")
# Qt's OpenSSL TLS backend loads these at runtime rather than linking them.
set(copied)
foreach(name libssl.3.dylib libcrypto.3.dylib)
  file(COPY "${sdk_lib_dir}/${name}" DESTINATION "${frameworks_dir}")
  list(APPEND copied "${name}")
  list(APPEND pending "${frameworks_dir}/${name}")
endforeach()
while(pending)
  list(POP_FRONT pending item)
  execute_process(COMMAND /usr/bin/otool -L "${item}" OUTPUT_VARIABLE linked COMMAND_ERROR_IS_FATAL ANY)
  string(REGEX MATCHALL "@rpath/[^ /\n]+\\.dylib" references "${linked}")
  foreach(reference IN LISTS references)
    string(REPLACE "@rpath/" "" name "${reference}")
    if(name IN_LIST copied OR NOT EXISTS "${sdk_lib_dir}/${name}")
      continue()
    endif()
    file(COPY "${sdk_lib_dir}/${name}" DESTINATION "${frameworks_dir}" FOLLOW_SYMLINK_CHAIN)
    list(APPEND copied "${name}")
    list(APPEND pending "${frameworks_dir}/${name}")
  endforeach()
endwhile()
list(LENGTH copied copied_count)
message(STATUS "Bundled ${copied_count} GStreamer SDK libraries")

function(add_rpath file path)
  execute_process(COMMAND /usr/bin/otool -l "${file}" OUTPUT_VARIABLE commands COMMAND_ERROR_IS_FATAL ANY)
  if(NOT commands MATCHES "path ${path} ")
    execute_process(COMMAND /usr/bin/install_name_tool -add_rpath "${path}" "${file}" COMMAND_ERROR_IS_FATAL ANY)
  endif()
endfunction()
# Remove absolute build-machine rpaths so the SDK install can never be loaded.
foreach(executable "${binary_dir}/@CMAKE_PROJECT_PROPER_NAME@" "${binary_dir}/deskflow-core")
  execute_process(COMMAND /usr/bin/otool -l "${executable}" OUTPUT_VARIABLE commands COMMAND_ERROR_IS_FATAL ANY)
  string(REGEX MATCHALL "path /[^ \n]+ \\(offset" absolute "${commands}")
  list(REMOVE_DUPLICATES absolute)
  foreach(entry IN LISTS absolute)
    string(REGEX REPLACE "^path (.+) \\(offset$" "\\1" entry "${entry}")
    execute_process(COMMAND /usr/bin/install_name_tool -delete_rpath "${entry}" "${executable}" COMMAND_ERROR_IS_FATAL ANY)
  endforeach()
  add_rpath("${executable}" "@loader_path/../Frameworks")
endforeach()
foreach(plugin IN LISTS plugins)
  add_rpath("${plugin}" "@loader_path/../../Frameworks")
endforeach()
add_rpath("${binary_dir}/gst-plugin-scanner" "@loader_path/../Frameworks")
foreach(name IN LISTS copied)
  add_rpath("${frameworks_dir}/${name}" "@loader_path")
endforeach()

# Relocation invalidates signatures. Sign nested native code before the final
# ad-hoc bundle seal; do not apply development debugging entitlements here.
file(GLOB_RECURSE native_files "${bundle}/Contents/*.dylib" "${bundle}/Contents/*.so")
list(APPEND native_files "${binary_dir}/gst-plugin-scanner" "${binary_dir}/deskflow-core")
foreach(native_file IN LISTS native_files)
  execute_process(COMMAND /usr/bin/codesign --force --sign - "${native_file}" COMMAND_ERROR_IS_FATAL ANY)
endforeach()
execute_process(COMMAND /usr/bin/codesign --force --deep --sign - "${bundle}" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND /usr/bin/codesign --verify --deep --strict "${bundle}" COMMAND_ERROR_IS_FATAL ANY)
